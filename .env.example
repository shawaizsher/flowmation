# ==================== DATABASE ====================
DB_NAME=flowa_db
DB_USER=flowa_user
DB_PASSWORD=change_me_in_production

# ==================== REDIS ====================
REDIS_PASSWORD=redis_password_change_me

# ==================== JWT ====================
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# ==================== NODE ENVIRONMENT ====================
NODE_ENV=development

# ==================== CORS ====================
CORS_ORIGIN=http://localhost:3000

# ==================== API URLS (for Docker & deployment) ====================
# Change these if running on a different domain/IP
# For localhost development: leave as default
# For server deployment: use your domain (e.g., https://api.yourdomain.com)
API_URL=http://localhost:4000
WS_URL=ws://localhost:4000

# ==================== DOCKER REGISTRY ====================
DOCKER_USERNAME=yourdockerusername
VERSION=latest

# ==================== PRODUCTION URLs ====================
API_URL=https://api.yourdomain.com
WS_URL=wss://api.yourdomain.com

# ==================== EMAIL (Optional) ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ==================== EXTERNAL APIS ====================
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
